# TourCRM Docker Compose development environment (Issue #8).
# Copy to `.env` (gitignored) and edit — never commit real values.
# These are for LOCAL DEVELOPMENT ONLY; production credentials are managed
# separately (docs/08-infrastructure/infrastructure-and-devops.md §9) and
# must never be copied here.

# PostgreSQL (development database — disposable, no production data)
POSTGRES_USER=tourcrm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tourcrm_dev

# Host ports — change if these are already in use on your machine.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# `docker compose up -d` starts every service: db, backend, frontend,
# scheduler, telegram-poller and outbox-worker (see README.md).
#
# Administrator Notification Settings (Issue #333, ADR-0048). SMTP and the
# Telegram bot are configured in the UI (Settings → Notifications), not
# here. Their secrets are stored encrypted with the settings key ring,
# passed to backend, outbox-worker and telegram-poller. Development value
# only — generate your own and never commit a real one:
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# SETTINGS_ENCRYPTION_KEYS=dev1:<base64 32-byte key>

# Password-reset code delivery key ring (Issue #342): same format, but a
# DIFFERENT key (generate a second one); passed to backend and outbox-worker,
# which therefore always share it. Without it no recovery code is issued.
# AUTH_DELIVERY_ENCRYPTION_KEYS=devmail1:<base64 32-byte key>

# Optional, outbox-worker only: public frontend address for links in
# notification messages (ADR-0049 §2.7). Empty = no links; an invalid value
# (credentials, query, fragment, not http(s)) stops the worker with exit 2.
# APP_PUBLIC_BASE_URL=http://localhost:5173
