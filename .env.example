# TourCRM Docker Compose development environment (Issue #8).
# Copy to `.env` (gitignored) and edit — never commit real values.
# These are for LOCAL DEVELOPMENT ONLY; production credentials are managed
# separately (docs/08-infrastructure/infrastructure-and-devops.md §9) and
# must never be copied here.

# PostgreSQL (development database — disposable, no production data)
POSTGRES_USER=tourcrm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tourcrm_dev

# Host ports — change if these are already in use on your machine.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Telegram (Issue #329, ADR-0047) — optional. The bot username is public and
# is passed to the backend for linking deep links. The bot token is a SECRET:
# it is read only by the `telegram-poller` profile service here; never commit
# a real token. Start the poller with: docker compose --profile telegram up
# TELEGRAM_BOT_USERNAME=my_club_bot
# TELEGRAM_BOT_TOKEN=
