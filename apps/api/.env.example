# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://tourcrm:changeme@localhost:5432/tourcrm_dev

# Whether session/CSRF cookies get the `Secure` flag (auth-api.md §19).
# Defaults to true; set to false only for local plain-HTTP development.
COOKIE_SECURE=true

# Root directory for the local FileStorage adapter (ADR-0040 §3). Binary
# document content is stored here, outside PostgreSQL. Defaults to
# var/file-storage (relative to the process working directory) if unset.
FILE_STORAGE_ROOT=var/file-storage

# Administrator Notification Settings (Issue #333, ADR-0048). SMTP and the
# Telegram bot (username, token) are configured by an administrator in
# Settings → Notifications and stored in PostgreSQL — there are NO SMTP_* or
# TELEGRAM_BOT_* environment variables. The only deployment secret is the
# settings encryption key ring, identical for the API, the outbox worker and
# the Telegram poller: <key_id>:<base64 32-byte key>[,<key_id>:<key>...]
# (first key encrypts, the others only decrypt — key rotation). Generate a key:
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Set it only through the deployment's secret management, never in a
# committed file. Rotation: docs/08-infrastructure/infrastructure-and-devops.md §9.1.
# SETTINGS_ENCRYPTION_KEYS=k2026a:<base64 key>

# Telegram poller tuning (python -m app.cli.run_telegram_poller). Run exactly
# ONE poller per installation.
# TELEGRAM_POLL_TIMEOUT_SECONDS=20
# TELEGRAM_POLL_BACKOFF_BASE_SECONDS=1
# TELEGRAM_POLL_BACKOFF_MAX_SECONDS=60
# TELEGRAM_POLL_CONFIG_INTERVAL_SECONDS=10
# TELEGRAM_API_BASE_URL — tests/local fake servers only; leave unset in every
# real deployment. Only https://api.telegram.org or http://127.0.0.1:<port> /
# localhost / [::1] are accepted; the token is part of every request URL.
