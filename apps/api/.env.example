# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://tourcrm:changeme@localhost:5432/tourcrm_dev

# Whether session/CSRF cookies get the `Secure` flag (auth-api.md §19).
# Defaults to true; set to false only for local plain-HTTP development.
COOKIE_SECURE=true

# Root directory for the local FileStorage adapter (ADR-0040 §3). Binary
# document content is stored here, outside PostgreSQL. Defaults to
# var/file-storage (relative to the process working directory) if unset.
FILE_STORAGE_ROOT=var/file-storage

# Notification Email delivery (Issue #327) — read by the outbox worker
# (python -m app.cli.run_outbox_worker). Leave SMTP_HOST unset to disable
# Email delivery. SMTP_PASSWORD is a secret: set it only through the
# environment/secret management of the deployment, never in a committed file.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls | ssl | none
# SMTP_TIMEOUT_SECONDS=30
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SENDER_EMAIL=noreply@example.org
# SMTP_SENDER_NAME=TourCRM

# Telegram (Issue #329, ADR-0047). Leave TELEGRAM_BOT_TOKEN unset to disable
# Telegram delivery (outbox worker) and polling. TELEGRAM_BOT_TOKEN is a
# SECRET: set it only through the environment/secret management of the
# outbox worker and the poller (python -m app.cli.run_telegram_poller), never
# in a committed file; the API process does not need it.
# TELEGRAM_BOT_USERNAME is public: the API needs it to build linking deep
# links (without it, issuing a link answers 503); the poller checks it
# against the token's bot. Run exactly ONE poller per bot token.
# TELEGRAM_BOT_USERNAME=my_club_bot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
# TELEGRAM_POLL_TIMEOUT_SECONDS=20
# TELEGRAM_POLL_BACKOFF_BASE_SECONDS=1
# TELEGRAM_POLL_BACKOFF_MAX_SECONDS=60
