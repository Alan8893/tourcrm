# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://tourcrm:changeme@localhost:5432/tourcrm_dev

# Whether session/CSRF cookies get the `Secure` flag (auth-api.md §19).
# Defaults to true; set to false only for local plain-HTTP development.
COOKIE_SECURE=true

# Root directory for the local FileStorage adapter (ADR-0040 §3). Binary
# document content is stored here, outside PostgreSQL. Defaults to
# var/file-storage (relative to the process working directory) if unset.
FILE_STORAGE_ROOT=var/file-storage
